# Zkopíruj tento soubor jako .env a vyplň hodnoty.
# Soubor .env NESMÍ být v gitu (je v .gitignore).

# iCloud SMTP přihlašovací údaje
# Uživatelské jméno = tvůj Apple ID nebo iCloud custom domain email
EMAIL_USER=cihi@bikeskills.cz

# App-specific password — vygeneruj na appleid.apple.com → Zabezpečení → Hesla pro aplikace
EMAIL_PASS=xxxx-xxxx-xxxx-xxxx
