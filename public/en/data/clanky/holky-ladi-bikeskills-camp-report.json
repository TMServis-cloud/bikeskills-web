_20200816_164617-1.webp?alt=media\" alt=\"\" data-id=\"174883\" data-full-url=\"https://firebasestorage.googleapis.com/v0/b/bikeskills-web.firebasestorage.app/o/wp-content%2Fuploads%2F2020%2F08%2FIMG_20200816_164617-1.webp?alt=media\" data-link=\"https://bikeskills.cz/?attachment_id=174883\" class=\"wp-image-174883\"/></figure></li><li class=\"blocks-gallery-item\"><figure><img src=\"https://firebasestorage.googleapis.com/v0/b/bikeskills-web.firebasestorage.app/o/wp-content%2Fuploads%2F2020%2F08%2FIMG_20200816_165756.webp?alt=media\" alt=\"\" data-id=\"174884\" data-full-url=\"https://firebasestorage.googleapis.com/v0/b/bikeskills-web.firebasestorage.app/o/wp-content%2Fuploads%2F2020%2F08%2FIMG_20200816_165756.webp?alt=media\" data-link=\"https://bikeskills.cz/?attachment_id=174884\" class=\"wp-image-174884\"/></figure></li></ul></figure>"}