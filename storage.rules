rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Obrázky (nové přes admin) - čtení pro všechny, zápis jen přihlášení
    match /images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Historické WP obrázky - veřejné čtení
    match /wp-content/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
