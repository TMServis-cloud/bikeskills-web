rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Obrázky - čtení pro všechny, upload jen pro přihlášené
    match /images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Deny all other access by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
