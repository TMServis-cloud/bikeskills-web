rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Akce - čtení pro všechny, zápis jen pro přihlášené
    match /akce/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Články - čtení pro všechny, zápis jen pro přihlášené
    match /clanky/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
